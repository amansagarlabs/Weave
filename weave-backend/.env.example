DATABASE_URL=jdbc:postgresql://localhost:5432/weave
DATABASE_USERNAME=weave
DATABASE_PASSWORD=weave
JWT_SECRET=replace-with-a-long-random-secret
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@weave.local
MAIL_PROVIDER=smtp
SPRING_PROFILES_ACTIVE=
# For Docker Mailserver production overlay:
# MAIL_HOST=mailserver
# MAIL_PORT=25
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=no-reply@yourdomain.com
# MAIL_DOMAIN=yourdomain.com
# MAILSERVER_HOSTNAME=mail
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
APP_PUBLIC_URL=http://localhost:3000
# Standalone UniBee Docker API from the Weave backend container:
# UNIBEE_BASE_URL=http://host.docker.internal:8088
UNIBEE_BASE_URL=https://api.unibee.dev
UNIBEE_API_KEY=
UNIBEE_PAYMENT_GATEWAY_ID=0
UNIBEE_PAYMENT_TYPE=
# Use these names for the local Docker Compose stack to avoid host-environment collisions.
WEAVE_UNIBEE_BASE_URL=http://host.docker.internal:8088
WEAVE_UNIBEE_API_KEY=
WEAVE_UNIBEE_PAYMENT_GATEWAY_ID=0
WEAVE_UNIBEE_PAYMENT_TYPE=
AUTH_EMAIL_VERIFICATION_LIFETIME=PT24H
AUTH_REFRESH_LIFETIME=P30D
AUTH_PASSWORD_RESET_LIFETIME=PT1H
AUTH_SECURE_COOKIES=false
SPRING_PROFILES_ACTIVE=
# Production: use SPRING_PROFILES_ACTIVE=prod and docker-compose.production.yml.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=http://192.168.*:3000
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
S3_ENDPOINT=
STORAGE_PROVIDER=s3
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_MAX_UPLOAD_BYTES=26214400
# Production Cloudinary option:
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=<cloud name>
# CLOUDINARY_API_KEY=<api key>
# CLOUDINARY_API_SECRET=<api secret>
# For Cloudflare R2 production, replace the S3 values above with:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=weave-assets
# S3_ACCESS_KEY=<R2 access key id>
# S3_SECRET_KEY=<R2 secret access key>
# S3_PUBLIC_BASE_URL=https://<public-r2-domain>/weave-assets
MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
MINIO_ROOT_USER=weave-minio
MINIO_ROOT_PASSWORD=change-this-minio-password
